<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib">

    <!--  =====================  -->
    <!--  COLOR BRUSHES  -->
    <!--  =====================  -->

    <!--  Primary nav button (#2A4494 dark blue)  -->
    <SolidColorBrush x:Key="NavPrimaryBrush" Color="#2A4494" />
    <SolidColorBrush x:Key="NavPrimaryHoverBrush" Color="#1E3375" />
    <SolidColorBrush x:Key="NavPrimaryPressedBrush" Color="#162860" />
    <SolidColorBrush x:Key="NavPrimaryFgBrush" Color="White" />

    <!--  Ghost nav button (#F0F0F0 light gray)  -->
    <SolidColorBrush x:Key="NavGhostBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="NavGhostHoverBrush" Color="#DCDCDC" />
    <SolidColorBrush x:Key="NavGhostPressedBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="NavGhostFgBrush" Color="#1E1E2E" />

    <!--  Page / text surfaces  -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E1E2E" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#CBD5E1" />

    <!--  =====================  -->
    <!--  FONT SIZES  -->
    <!--  =====================  -->
    <System:Double x:Key="FontSizeSmall">12</System:Double>
    <System:Double x:Key="FontSizeBase">13</System:Double>
    <System:Double x:Key="FontSizeMedium">15</System:Double>
    <System:Double x:Key="FontSizeLarge">20</System:Double>
    <System:Double x:Key="FontSizeTitle">26</System:Double>

    <!--  =====================  -->
    <!--  SHARED NAV BUTTON  -->
    <!--  CONTROL TEMPLATE  -->
    <!--  Both primary and  -->
    <!--  ghost share this.  -->
    <!--  Tag = hover color.  -->
    <!--  =====================  -->
    <ControlTemplate x:Key="NavButtonTemplate" TargetType="Button">
        <Border
            x:Name="Bd"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderThickness="0"
            CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  =====================  -->
    <!--  PRIMARY NAV BUTTON  -->
    <!--  Forward actions  -->
    <!--  "Go to Page →"  -->
    <!--  =====================  -->
    <Style x:Key="NavPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource NavPrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NavPrimaryFgBrush}" />
        <Setter Property="Tag" Value="{StaticResource NavPrimaryHoverBrush}" />
        <Setter Property="Template" Value="{StaticResource NavButtonTemplate}" />
    </Style>

    <!--  =====================  -->
    <!--  GHOST NAV BUTTON  -->
    <!--  Back actions  -->
    <!--  "← Back to Main"  -->
    <!--  =====================  -->
    <Style x:Key="NavGhostButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource NavGhostBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NavGhostFgBrush}" />
        <Setter Property="Tag" Value="{StaticResource NavGhostHoverBrush}" />
        <Setter Property="Template" Value="{StaticResource NavButtonTemplate}" />
    </Style>

    <!--  =====================  -->
    <!--  NAV BAR CONTAINER  -->
    <!--  StackPanel wrapping  -->
    <!--  all nav buttons  -->
    <!--  =====================  -->
    <Style x:Key="NavBarStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="12" />
    </Style>

    <!--  =====================  -->
    <!--  PAGE CONTAINER  -->
    <!--  Root Grid of each  -->
    <!--  View  -->
    <!--  =====================  -->
    <Style x:Key="PageContainerStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
    </Style>

    <!--  =====================  -->
    <!--  PAGE TITLE  -->
    <!--  Large heading at  -->
    <!--  top of each page  -->
    <!--  =====================  -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <!--  =====================  -->
    <!--  BODY TEXT  -->
    <!--  Standard paragraph  -->
    <!--  text on any page  -->
    <!--  =====================  -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  ==========================================================  -->
    <!--  OPERATOR PANEL (touch screen) - used by MainPageView  -->
    <!--  ==========================================================  -->

    <SolidColorBrush x:Key="PanelBorderBrush" Color="Blue" />
    <SolidColorBrush x:Key="PanelActiveBrush" Color="#0070C0" />
    <SolidColorBrush x:Key="ActionYellowBrush" Color="#FDEF75" />
    <SolidColorBrush x:Key="DangerBrush" Color="#ED524F" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#33000000" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="Gray" />

    <!--  Rounded panel button with drop shadow.  -->
    <!--  Press feedback = dark overlay (works even if Background is bound).  -->
    <ControlTemplate x:Key="PanelButtonTemplate" TargetType="Button">
        <Border
            x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="15">
            <Grid>
                <Border
                    x:Name="PressOverlay"
                    Background="Black"
                    CornerRadius="15"
                    IsHitTestVisible="False"
                    Opacity="0" />
                <ContentPresenter
                    Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
            <Border.Effect>
                <DropShadowEffect
                    Direction="-40"
                    Opacity="0.3"
                    ShadowDepth="4" />
            </Border.Effect>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PressOverlay" Property="Opacity" Value="0.25" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  White panel button. Set Tag="{Binding SomeBool}": when true the button turns blue (selected / active).  -->
    <Style x:Key="PanelButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PanelButtonTemplate}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource PanelActiveBrush}" />
                <Setter Property="Foreground" Value="White" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Yellow action button (system setting etc.)  -->
    <Style
        x:Key="PanelButtonYellowStyle"
        BasedOn="{StaticResource PanelButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ActionYellowBrush}" />
    </Style>

    <!--  STOP button: red text, turns solid red while pressed  -->
    <Style
        x:Key="StopButtonStyle"
        BasedOn="{StaticResource PanelButtonStyle}"
        TargetType="Button">
        <Setter Property="Foreground" Value="Red" />
        <Setter Property="FontSize" Value="80" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Value box that behaves like a button (tap -> keypad)  -->
    <ControlTemplate x:Key="InputBoxButtonTemplate" TargetType="Button">
        <Border
            x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="5">
            <Grid>
                <Border
                    x:Name="PressOverlay"
                    Background="Black"
                    CornerRadius="5"
                    IsHitTestVisible="False"
                    Opacity="0" />
                <ContentPresenter
                    Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PressOverlay" Property="Opacity" Value="0.2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="InputBoxButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource InputBoxButtonTemplate}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!--  Section card  -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="CardHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="LabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Black read-only value cell (white text)  -->
    <Style x:Key="ValueBoxBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Black" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Height" Value="70" />
        <Setter Property="Margin" Value="4" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ValueBoxTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="48" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Bottom status bar: gray normally, red when HasAlarm is true  -->
    <Style x:Key="StatusBarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StatusBarBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="15" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  GroupBox with the title offset from the left corner (change the 20 below to move the title)  -->
    <Style x:Key="PanelGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="#9A9A9A" />
        <Setter Property="Padding" Value="10,6,10,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Top line: [left piece] [title] [right piece]  -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Margin="0,16,0,0"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5,1.5,0,0"
                                CornerRadius="8,0,0,0" />

                            <ContentPresenter
                                Grid.Column="1"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />

                            <Border
                                Grid.Column="2"
                                Margin="0,16,0,0"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,1.5,1.5,0"
                                CornerRadius="0,8,0,0" />
                        </Grid>

                        <!--  Body: sides and bottom of the frame  -->
                        <Border
                            Grid.Row="1"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5,0,1.5,1.5"
                            CornerRadius="0,0,8,8">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DesignCanvasViewboxStyle" TargetType="Viewbox">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StretchDirection" Value="Both" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="DesignCanvasGridStyle" TargetType="Grid">
        <Setter Property="Width" Value="1920" />
        <Setter Property="Height" Value="1080" />
        <Setter Property="Background" Value="LightYellow" />
    </Style>

    <!--  ===== Action button colors =====  -->
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#FF1E6FD9" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#FF3A85EA" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#FF1757AD" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#FF555555" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#FF6E6E6E" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#FF3F3F3F" />

    <!--  Shared shape: reuses PanelButtonTemplate (drop shadow + press overlay + disabled look)  -->
    <Style x:Key="ActionButtonBaseStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PanelButtonTemplate}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!--  Primary: main action (OK, はい, 保存)  -->
    <Style
        x:Key="PrimaryButtonStyle"
        BasedOn="{StaticResource ActionButtonBaseStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryButtonHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Secondary: back / cancel (戻る, キャンセル, いいえ)  -->
    <Style
        x:Key="SecondaryButtonStyle"
        BasedOn="{StaticResource ActionButtonBaseStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SecondaryButtonHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
