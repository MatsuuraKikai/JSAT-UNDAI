<UserControl
    x:Class="JSAT_UNDAI.Views.SettingPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:JSAT_UNDAI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:JSAT_UNDAI.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SettingPageViewModel}"
    mc:Ignorable="d">

    <Viewbox Style="{StaticResource DesignCanvasViewboxStyle}">
        <Grid Style="{StaticResource DesignCanvasGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ================= Content: left / right columns =================  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="820" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ============ LEFT: network + gimbal ============  -->
                <StackPanel Grid.Column="0">
                    <GroupBox Style="{StaticResource PanelGroupBoxStyle}">
                        <GroupBox.Header>
                            <TextBlock
                                FontSize="30"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Style="{StaticResource SettingSectionTitleStyle}"
                                Text="ネットワーク設定" />
                        </GroupBox.Header>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="雲台IPアドレス" />
                            <ui:TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiTextBoxStyle}"
                                Text="{Binding UndaiIpAddress, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="サブネットマスク" />
                            <ui:TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiTextBoxStyle}"
                                Text="{Binding UndaiSubnetMask, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="2"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="デフォルトゲートウェイ" />
                            <ui:TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiTextBoxStyle}"
                                Text="{Binding UndaiGateway, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="モデムIPアドレス" />
                            <ui:TextBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiTextBoxStyle}"
                                Text="{Binding ModemIpAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Margin="0,30,0,8" Style="{StaticResource PanelGroupBoxStyle}">
                        <GroupBox.Header>
                            <TextBlock
                                FontSize="30"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Style="{StaticResource SettingSectionTitleStyle}"
                                Text="雲台設定" />
                        </GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                            </Grid.RowDefinitions>

                            <!--  Column headers  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="水平角" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="仰角" />

                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="原点オフセット(度)" />
                            <ui:NumberBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding OriginOffsetAzimuth, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:NumberBox
                                Grid.Row="1"
                                Grid.Column="3"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding OriginOffsetElevation, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="2"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="手動高速[1-100]" />
                            <ui:NumberBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding ManualHighSpeedAzimuth, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:NumberBox
                                Grid.Row="2"
                                Grid.Column="3"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding ManualHighSpeedElevation, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="手動低速[1-100]" />
                            <ui:NumberBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding ManualLowSpeedAzimuth, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:NumberBox
                                Grid.Row="3"
                                Grid.Column="3"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding ManualLowSpeedElevation, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="4"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="寸動角度(度)" />
                            <ui:NumberBox
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding JogAngleAzimuth, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:NumberBox
                                Grid.Row="4"
                                Grid.Column="3"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding JogAngleElevation, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                    </GroupBox>

                    <GroupBox Margin="0,30,0,8" Style="{StaticResource PanelGroupBoxStyle}">
                        <GroupBox.Header>
                            <TextBlock
                                FontSize="30"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Style="{StaticResource SettingSectionTitleStyle}"
                                Text="衛星設定" />
                        </GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="衛星名" />
                            <ui:TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiTextBoxStyle}"
                                Text="{Binding SatelliteName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="衛星経度" />
                            <ui:NumberBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding SatelliteLongitude, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                    </GroupBox>

                    <!--  Alarm buttons  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="235"
                            Height="70"
                            Command="{Binding AlarmResetCommand}"
                            Content="アラームリセット"
                            FontSize="28"
                            Style="{StaticResource SecondaryButtonStyle}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="235"
                            Height="70"
                            Command="{Binding AlarmHistoryCommand}"
                            Content="アラーム履歴"
                            FontSize="28"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </StackPanel>

                <!--  ============ RIGHT: search settings ============  -->
                <StackPanel Grid.Column="2">

                    <GroupBox Style="{StaticResource PanelGroupBoxStyle}">
                        <GroupBox.Header>
                            <TextBlock
                                FontSize="30"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Style="{StaticResource SettingSectionTitleStyle}"
                                Text="広域サーチ設定" />
                        </GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="270" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="広域サーチ速度[1-100]" />
                            <ui:NumberBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding WideSearchSpeed, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="広域サーチ水平角度(度)(±)" />
                            <ui:NumberBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding WideSearchAzimuthRange, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="2"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="広域サーチ垂直角度(度)(±)" />
                            <ui:NumberBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding WideSearchElevationRange, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="広域成功RSSIレベル(dBm)" />
                            <ui:NumberBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding WideSearchSuccessRssi, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                    </GroupBox>
                    <GroupBox Margin="0,30,0,8" Style="{StaticResource PanelGroupBoxStyle}">
                        <GroupBox.Header>
                            <TextBlock
                                FontSize="30"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Style="{StaticResource SettingSectionTitleStyle}"
                                Text="詳細サーチ設定" />
                        </GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="270" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="48" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="詳細サーチ速度[1-100]" />
                            <ui:NumberBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding DetailSearchSpeed, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="詳細サーチステップ角(度)" />
                            <ui:NumberBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding DetailSearchStepAngle, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="2"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="詳細サーチ水平角度(度)(±)" />
                            <ui:NumberBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding DetailSearchAzimuthRange, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="詳細サーチ垂直角度(度)(±)" />
                            <ui:NumberBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding DetailSearchElevationRange, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="4"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="詳細サーチ成功RSSIレベル(dBm)" />
                            <ui:NumberBox
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding DetailSearchSuccessRssi, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="5"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="ステップ安定秒" />
                            <ui:NumberBox
                                Grid.Row="5"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding DetailSearchStepSettleSeconds, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="6"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="打切り減衰(dBm)" />
                            <ui:NumberBox
                                Grid.Row="6"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding DetailSearchTurnbackThresholdLevel, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                    </GroupBox>
                    <GroupBox Margin="0,30,0,8" Style="{StaticResource PanelGroupBoxStyle}">
                        <GroupBox.Header>
                            <TextBlock
                                FontSize="30"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Style="{StaticResource SettingSectionTitleStyle}"
                                Text="体力設定" />
                        </GroupBox.Header>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="270" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="5" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="連続運転終了時間(分)" />
                            <ui:NumberBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource SettingUiNumberBoxStyle}"
                                Text="{Binding ContinuousRunMinutes, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Width="235"
                                    Height="70"
                                    HorizontalAlignment="Center"
                                    Command="{Binding StopCommand}"
                                    Content="停止"
                                    FontSize="30"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                                <Button
                                    Grid.Column="1"
                                    Width="235"
                                    Height="70"
                                    HorizontalAlignment="Center"
                                    Command="{Binding StartContinuousRunCommand}"
                                    Content="連続運転開始"
                                    FontSize="30"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </Grid>

            <!--  ================= Undai Version =================  -->
            <Grid Grid.Row="1">
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Right"
                    FontSize="20"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{Binding UndaiVersionText, StringFormat=雲台Ver {0}}" />
            </Grid>

            <!--  ================= Error Message =================  -->
            <Grid Grid.Row="2" HorizontalAlignment="Right">
                <TextBlock FontSize="24" Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!--  ================= Bottom bar =================  -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button
                        Width="235"
                        Height="70"
                        Command="{Binding NavigateToMainPageCommand}"
                        Content="戻る"
                        FontSize="30"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        Width="235"
                        Height="70"
                        Margin="30,0,0,0"
                        Command="{Binding PinResetCommand}"
                        Content="暗証番号リセット"
                        FontSize="28"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        Width="235"
                        Height="70"
                        Margin="30,0,0,0"
                        Command="{Binding NavigateToDeveloperPageCommand}"
                        Content="保守モード"
                        FontSize="30"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Width="235"
                    Height="70"
                    HorizontalAlignment="Right"
                    Command="{Binding SaveCommand}"
                    Content="登録"
                    FontSize="28"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>