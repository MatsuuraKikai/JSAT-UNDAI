<UserControl
    x:Class="JSAT_UNDAI.Views.SettingPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:JSAT_UNDAI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:JSAT_UNDAI.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SettingPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Viewbox
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Stretch="Fill"
        StretchDirection="Both"
        UseLayoutRounding="True">
        <Grid
            Width="1920"
            Height="1200"
            Background="#F0F4FF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="10"
                FontSize="24"
                FontWeight="Bold"
                Text="Setting Page" />
            <StackPanel Grid.Row="1" Margin="10">
                <ui:Button
                    Width="100"
                    Height="30"
                    Margin="0,0,0,10"
                    Command="{Binding ClickMeCommand}"
                    Content="Click Me"
                    Style="{StaticResource NavGhostButtonStyle}" />
                <ui:TextBox Width="200" PlaceholderText="Enter text here" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="10">
                <ui:Button
                    Width="150"
                    Height="30"
                    Margin="0,0,0,10"
                    Command="{Binding NavigateToMainPageCommand}"
                    Content="Main Page"
                    Style="{StaticResource NavPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
