<UserControl
    x:Class="JSAT_UNDAI.Views.SystemResetSettingPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JSAT_UNDAI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">
    <Viewbox Style="{StaticResource DesignCanvasViewboxStyle}">

        <Grid Style="{StaticResource DesignCanvasGridStyle}">
            <Image
                Width="1500"
                Height="750"
                Source="/Resources/ResetUndaiForDefaultIP.png"
                Stretch="UniformToFill"
                Visibility="{Binding ResetUndaiImgVisibility, Converter={StaticResource BoolToVisibilityConverter}}" />

            <StackPanel Margin="10">
                <Border>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400" />
                            <ColumnDefinition Width="500" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="AUTO" />
                            <RowDefinition Height="AUTO" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="5"
                            FontSize="40"
                            Text="Default IP Address" />

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5"
                            Background="White"
                            BorderBrush="Blue"
                            BorderThickness="1"
                            CornerRadius="5">
                            <TextBlock
                                Padding="5"
                                FontSize="40"
                                Text="{Binding DefaultIPAddress}" />
                        </Border>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="5"
                            FontSize="40"
                            Text="Current IP Address" />

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5"
                            Background="White"
                            BorderBrush="Blue"
                            BorderThickness="1"
                            CornerRadius="5">

                            <TextBlock
                                Padding="5"
                                FontSize="40"
                                Text="{Binding CurrentIPAddress}" />
                        </Border>
                    </Grid>
                </Border>
                <Grid>
                    <Border Margin="5,0,5,5" HorizontalAlignment="Right">
                        <ui:Button
                            Width="350"
                            Content="デフォルトにリセット"
                            FontSize="40"
                            Command="{Binding ResetToDefaultCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </Border>
                    <Border Margin="5,0,5,5" HorizontalAlignment="Left">

                        <ui:Button
                            Width="250"
                            Command="{Binding NavigateToMainPageCommand}"
                            Content="戻る"
                            FontSize="40"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
