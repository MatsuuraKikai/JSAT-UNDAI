<Window
    x:Class="JSAT_UNDAI.Views.Base.PinChangeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ピン変更"
    Width="680"
    Height="460"
    Background="LightYellow"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!--  Local key on purpose: a view style with the same key as a shared one would override it  -->
        <Style x:Key="PinLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="30,20,30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title  -->
        <TextBlock
            Grid.Row="0"
            FontSize="32"
            FontWeight="Bold"
            Foreground="{StaticResource TextPrimaryBrush}"
            Text="ピンの変更" />

        <!--  Current PIN  -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource PinLabelStyle}" Text="暗証番号" />
            <ui:PasswordBox
                x:Name="CurrentPinBox"
                Grid.Column="1"
                Height="44"
                FontSize="26"
                Foreground="Black"
                Icon="{ui:SymbolIcon Password24}"
                InputMethod.IsInputMethodEnabled="False"
                InputScope="Number"
                MaxLength="4"
                PlaceholderText="暗証番号"
                PreviewTextInput="OnDigitOnlyPreview"
                RevealButtonEnabled="False" />
        </Grid>

        <!--  New PIN  -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource PinLabelStyle}" Text="新しい暗証番号" />
            <ui:PasswordBox
                x:Name="NewPinBox"
                Grid.Column="1"
                Height="44"
                FontSize="26"
                Foreground="Black"
                Icon="{ui:SymbolIcon Password24}"
                InputMethod.IsInputMethodEnabled="False"
                InputScope="Number"
                MaxLength="4"
                PlaceholderText="数字4桁"
                PreviewTextInput="OnDigitOnlyPreview"
                RevealButtonEnabled="False" />
        </Grid>

        <!--  Confirm new PIN  -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource PinLabelStyle}" Text="確認新しい暗証番号" />
            <ui:PasswordBox
                x:Name="ConfirmPinBox"
                Grid.Column="1"
                Height="44"
                FontSize="26"
                Foreground="Black"
                Icon="{ui:SymbolIcon Password24}"
                InputMethod.IsInputMethodEnabled="False"
                InputScope="Number"
                MaxLength="4"
                PlaceholderText="新しい暗証番号(確認)"
                PreviewTextInput="OnDigitOnlyPreview"
                RevealButtonEnabled="False" />
        </Grid>

        <!--  Hint + error (MinHeight so the buttons do not jump when an error appears)  -->
        <TextBlock
            x:Name="MessageText"
            Grid.Row="5"
            MinHeight="34"
            Margin="0,10,0,0"
            FontSize="22"
            Foreground="Gray"
            Text="数字4桁で入力してください"
            TextWrapping="Wrap" />

        <!--  OK / Cancel  -->
        <Grid Grid.Row="7" Height="64">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Click="OnOkClick"
                Content="OK"
                FontSize="30"
                IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}" />
            <Button
                Grid.Column="2"
                Content="キャンセル"
                FontSize="30"
                IsCancel="True"
                Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>