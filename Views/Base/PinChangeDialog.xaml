<Window
    x:Class="JSAT_UNDAI.Views.Base.PinChangeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="暗証番号変更"
    Width="680"
    Height="460"
    Background="LightYellow"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <!--  =====================================================  -->
    <!--  WINDOW RESOURCES: local label style  -->
    <!--  =====================================================  -->
    <Window.Resources>
        <!--  Local key on purpose: a view style with the same key as a shared one would override it  -->
        <Style x:Key="PinLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <!--  =====================================================  -->
    <!--  ROOT LAYOUT: title / current PIN / new PIN / confirm PIN / message / buttons  -->
    <!--  =====================================================  -->
    <Grid Margin="30,20,30,25">
        <Grid.RowDefinitions>
            <!--  Row 0: title  -->
            <RowDefinition Height="Auto" />
            <!--  Row 1: spacer  -->
            <RowDefinition Height="20" />
            <!--  Row 2: current PIN  -->
            <RowDefinition Height="Auto" />
            <!--  Row 3: new PIN  -->
            <RowDefinition Height="Auto" />
            <!--  Row 4: confirm new PIN  -->
            <RowDefinition Height="Auto" />
            <!--  Row 5: hint / error message  -->
            <RowDefinition Height="Auto" />
            <!--  Row 6: flexible gap  -->
            <RowDefinition Height="*" />
            <!--  Row 7: OK / cancel buttons  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  =====================================================  -->
        <!--  ROW 0: TITLE "暗証番号の変更" (change PIN)  -->
        <!--  =====================================================  -->
        <TextBlock
            Grid.Row="0"
            FontSize="32"
            FontWeight="Bold"
            Foreground="{StaticResource TextPrimaryBrush}"
            Text="暗証番号の変更" />

        <!--  =====================================================  -->
        <!--  ROW 2: CURRENT PIN "暗証番号" (label + input)  -->
        <!--  =====================================================  -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!--  Col 0: label  -->
                <ColumnDefinition Width="300" />
                <!--  Col 1: input box  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  Col 0: Current PIN label "暗証番号"  -->
            <TextBlock Style="{StaticResource PinLabelStyle}" Text="暗証番号" />
            <!--  Col 1: Current PIN input (digits only, max 4, IME off, reveal button off)  -->
            <ui:PasswordBox
                x:Name="CurrentPinBox"
                Grid.Column="1"
                Height="44"
                FontSize="26"
                Foreground="Black"
                Icon="{ui:SymbolIcon Password24}"
                InputMethod.IsInputMethodEnabled="False"
                InputScope="Number"
                MaxLength="4"
                PlaceholderText="暗証番号"
                PreviewTextInput="OnDigitOnlyPreview"
                RevealButtonEnabled="False" />
        </Grid>

        <!--  =====================================================  -->
        <!--  ROW 3: NEW PIN "新しい暗証番号" (label + input)  -->
        <!--  =====================================================  -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!--  Col 0: label  -->
                <ColumnDefinition Width="300" />
                <!--  Col 1: input box  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  Col 0: New PIN label "新しい暗証番号"  -->
            <TextBlock Style="{StaticResource PinLabelStyle}" Text="新しい暗証番号" />
            <!--  Col 1: New PIN input (digits only, max 4, IME off, reveal button off)  -->
            <ui:PasswordBox
                x:Name="NewPinBox"
                Grid.Column="1"
                Height="44"
                FontSize="26"
                Foreground="Black"
                Icon="{ui:SymbolIcon Password24}"
                InputMethod.IsInputMethodEnabled="False"
                InputScope="Number"
                MaxLength="4"
                PlaceholderText="数字4桁"
                PreviewTextInput="OnDigitOnlyPreview"
                RevealButtonEnabled="False" />
        </Grid>

        <!--  =====================================================  -->
        <!--  ROW 4: CONFIRM NEW PIN "確認新しい暗証番号" (label + input)  -->
        <!--  =====================================================  -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <!--  Col 0: label  -->
                <ColumnDefinition Width="300" />
                <!--  Col 1: input box  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  Col 0: Confirm new PIN label "確認新しい暗証番号"  -->
            <TextBlock Style="{StaticResource PinLabelStyle}" Text="確認新しい暗証番号" />
            <!--  Col 1: Confirm new PIN input (digits only, max 4, IME off, reveal button off)  -->
            <ui:PasswordBox
                x:Name="ConfirmPinBox"
                Grid.Column="1"
                Height="44"
                FontSize="26"
                Foreground="Black"
                Icon="{ui:SymbolIcon Password24}"
                InputMethod.IsInputMethodEnabled="False"
                InputScope="Number"
                MaxLength="4"
                PlaceholderText="新しい暗証番号(確認)"
                PreviewTextInput="OnDigitOnlyPreview"
                RevealButtonEnabled="False" />
        </Grid>

        <!--  =====================================================  -->
        <!--  ROW 5: HINT / ERROR MESSAGE (MinHeight so the buttons do not jump when an error appears)  -->
        <!--  =====================================================  -->
        <TextBlock
            x:Name="MessageText"
            Grid.Row="5"
            MinHeight="34"
            Margin="0,10,0,0"
            FontSize="22"
            Foreground="Gray"
            Text="数字4桁で入力してください"
            TextWrapping="Wrap" />

        <!--  =====================================================  -->
        <!--  ROW 7: BUTTONS (OK on the left, cancel on the right)  -->
        <!--  =====================================================  -->
        <Grid Grid.Row="7" Height="64">
            <Grid.ColumnDefinitions>
                <!--  Col 0: OK button  -->
                <ColumnDefinition Width="*" />
                <!--  Col 1: spacer  -->
                <ColumnDefinition Width="30" />
                <!--  Col 2: cancel button  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  Col 0: OK button "OK" (default button, triggered by the Enter key)  -->
            <Button
                Grid.Column="0"
                Click="OnOkClick"
                Content="OK"
                FontSize="30"
                IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}" />
            <!--  Col 2: Cancel button "キャンセル" (cancel button, triggered by the Esc key, closes the dialog)  -->
            <Button
                Grid.Column="2"
                Content="キャンセル"
                FontSize="30"
                IsCancel="True"
                Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
