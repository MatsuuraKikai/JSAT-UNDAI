<Window
    x:Class="JSAT_UNDAI.Views.Base.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="確認"
    Width="600"
    Height="210"
    Background="LightYellow"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <!--  =====================================================  -->
    <!--  ROOT LAYOUT: message / buttons  -->
    <!--  =====================================================  -->
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <!--  Row 0: message text  -->
            <RowDefinition Height="Auto" />
            <!--  Row 1: spacer  -->
            <RowDefinition Height="20" />
            <!--  Row 2: Yes / No buttons  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  =====================================================  -->
        <!--  ROW 0: MESSAGE (text is set from code-behind)  -->
        <!--  =====================================================  -->
        <TextBlock
            x:Name="MessageText"
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="25"
            FontWeight="SemiBold"
            Foreground="{StaticResource TextPrimaryBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <!--  =====================================================  -->
        <!--  ROW 2: BUTTONS (Yes on the left, No on the right)  -->
        <!--  =====================================================  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!--  Col 0: Yes button  -->
                <ColumnDefinition Width="*" />
                <!--  Col 1: spacer  -->
                <ColumnDefinition Width="30" />
                <!--  Col 2: No button  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  Col 0: Yes button "OK" (confirms the action)  -->
            <Button
                x:Name="YesButton"
                Grid.Column="0"
                Click="OnYesClick"
                Content="OK"
                FontSize="30"
                Style="{StaticResource PrimaryButtonStyle}" />
            <!--  No = default + Esc, so an accidental Enter or touch does not confirm  -->
            <!--  Col 2: No button "キャンセル" (default button and cancel button)  -->
            <Button
                x:Name="NoButton"
                Grid.Column="2"
                Content="キャンセル"
                FontSize="30"
                IsCancel="True"
                IsDefault="True"
                Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
