<Window
    x:Class="JSAT_UNDAI.Views.Base.PinEntryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:JSAT_UNDAI.ViewModels.Base"
    Title="暗証番号入力"
    Width="500"
    Height="380"
    d:DataContext="{d:DesignInstance Type=vm:PinEntryViewModel}"
    Background="LightYellow"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <!--  =====================================================  -->
    <!--  ROOT LAYOUT: prompt / PIN display / error message / buttons  -->
    <!--  =====================================================  -->
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <!--  Row 0: prompt text  -->
            <RowDefinition Height="Auto" />
            <!--  Row 1: PIN display box (with hidden input)  -->
            <RowDefinition Height="Auto" />
            <!--  Row 2: error message  -->
            <RowDefinition Height="Auto" />
            <!--  Row 3: OK / cancel buttons  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  =====================================================  -->
        <!--  ROW 0: PROMPT "暗証番号（4桁）を入力してください" (enter the 4 digit PIN)  -->
        <!--  =====================================================  -->
        <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Center"
            FontSize="25"
            FontWeight="SemiBold"
            Foreground="{StaticResource TextPrimaryBrush}"
            Text="暗証番号（4桁）を入力してください" />

        <!--  =====================================================  -->
        <!--  ROW 1: PIN INPUT (visible display box overlaid by a transparent PasswordBox)  -->
        <!--  =====================================================  -->
        <Grid
            Grid.Row="1"
            Width="300"
            Height="90"
            Margin="0,20,0,0">
            <!--  Layer 1 (back): PIN display box (shows the masked PIN from the view model)  -->
            <Border
                Background="#70000000"
                CornerRadius="10"
                Style="{StaticResource ValueBoxBorderStyle}">
                <TextBlock
                    FontSize="50"
                    Style="{StaticResource ValueBoxTextStyle}"
                    Text="{Binding PinDisplay}" />
            </Border>
            <!--  Layer 2 (front): Hidden PasswordBox (Opacity 0, receives the key input, max 4 characters)  -->
            <PasswordBox
                x:Name="PinBox"
                FontSize="50"
                MaxLength="4"
                Opacity="0"
                PasswordChanged="OnPinPasswordChanged"
                PreviewTextInput="OnPinPreviewTextInput" />
        </Grid>

        <!--  =====================================================  -->
        <!--  ROW 2: ERROR MESSAGE (empty when everything is fine)  -->
        <!--  =====================================================  -->
        <TextBlock
            Grid.Row="2"
            MinHeight="44"
            Margin="0,16,0,0"
            VerticalAlignment="Center"
            FontSize="26"
            Foreground="Red"
            Text="{Binding ErrorMessage}"
            TextWrapping="Wrap" />

        <!--  =====================================================  -->
        <!--  ROW 3: BUTTONS (OK on the left, cancel on the right)  -->
        <!--  =====================================================  -->
        <Grid Grid.Row="3" Margin="0,8">
            <Grid.ColumnDefinitions>
                <!--  Col 0: OK button  -->
                <ColumnDefinition Width="*" />
                <!--  Col 1: spacer  -->
                <ColumnDefinition Width="30" />
                <!--  Col 2: cancel button  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  Col 0: OK button "OK" (default button, triggered by the Enter key)  -->
            <Button
                Grid.Column="0"
                Command="{Binding OkCommand}"
                Content="OK"
                FontSize="30"
                IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}" />
            <!--  Col 2: Cancel button "キャンセル" (cancel button, triggered by the Esc key, closes the dialog)  -->
            <Button
                Grid.Column="2"
                Content="キャンセル"
                FontSize="30"
                IsCancel="True"
                Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
