<Window
    x:Class="JSAT_UNDAI.Views.Base.UNDAIRestartDialogBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JSAT_UNDAI.Views.Base"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="UNDAIRestartDialogBox"
    Width="800"
    Height="600"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <!--  =====================================================  -->
    <!--  ROOT LAYOUT: dialog background (beige)  -->
    <!--  =====================================================  -->
    <Grid Background="#e6e6ca">

        <!--  =====================================================  -->
        <!--  CONTENT: vertical stack (image / message / OK button)  -->
        <!--  =====================================================  -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!--  STACK 1) Restart guide image  -->
            <ui:Image
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="\RESOURCES\ResetUndaiForSettingChanged.png"
                Stretch="UniformToFill" />

            <!--  STACK 2) Message: "雲台を再起動して下さい。" (please restart the undai)  -->
            <TextBlock
                Margin="10"
                HorizontalAlignment="Center"
                FontSize="30"
                Foreground="Black"
                Text="雲台を再起動して下さい。" />

            <ui:Button
                Width="150"
                Click="OkButton_Click"
                Content="OK"
                FontSize="30"
                IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}" />

        </StackPanel>
    </Grid>
</Window>
