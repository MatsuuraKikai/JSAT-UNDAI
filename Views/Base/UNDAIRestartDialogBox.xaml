<Window
    x:Class="JSAT_UNDAI.Views.Base.UNDAIRestartDialogBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JSAT_UNDAI.Views.Base"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="UNDAIRestartDialogBox"
    Width="800"
    Height="600"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <!--  =====================================================  -->
    <!--  ROOT LAYOUT: dialog background (beige)  -->
    <!--  =====================================================  -->
    <Grid Background="#e6e6ca">

        <!--  =====================================================  -->
        <!--  CONTENT: vertical stack (image / message / OK button)  -->
        <!--  =====================================================  -->
        <StackPanel
            Width="800"
            Height="580"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <!--  STACK 1) Restart guide image  -->
            <Image
                Width="500"
                Height="250"
                MaxWidth="600"
                Margin="0,80"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="\RESOURCES\ResetUndaiForSettingChanged.png"
                Stretch="UniformToFill" />

            <!--  STACK 2) Message: "雲台を再起動して下さい。" (please restart the undai)  -->
            <TextBlock
                Margin="10"
                HorizontalAlignment="Center"
                FontSize="40"
                Foreground="Black"
                Text="雲台を再起動して下さい。" />

            <!--  STACK 3) OK button: "OK" (no Command is bound)  -->
            <Button
                Width="150"
                Height="50"
                Content="OK"
                FontSize="30"
                Style="{StaticResource PrimaryButtonStyle}" />

        </StackPanel>
    </Grid>
</Window>
