<Window
    x:Class="JSAT_UNDAI.Views.InstallationEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:JSAT_UNDAI.ViewModels"
    Title="設置情報設定"
    Width="800"
    d:DataContext="{d:DesignInstance Type=vm:InstallationEditViewModel}"
    Background="LightYellow"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  =====================  UNDAI (雲台) : GPS source  =====================  -->
        <GroupBox
            Grid.Row="0"
            Padding="20,20"
            Style="{StaticResource PanelGroupBoxStyle}">
            <GroupBox.Header>
                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="雲台" />
            </GroupBox.Header>

            <StackPanel>
                <!--  Auto / manual toggle  -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,40,0"
                        VerticalAlignment="Center"
                        FontSize="25"
                        Style="{StaticResource LabelTextStyle}"
                        Text="GPS情報入力" />
                    <ui:ToggleSwitch
                        VerticalAlignment="Center"
                        Content="{Binding GpsModeLabel}"
                        FontSize="20"
                        IsChecked="{Binding IsManualGps}">
                        <ui:ToggleSwitch.LayoutTransform>
                            <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                        </ui:ToggleSwitch.LayoutTransform>
                    </ui:ToggleSwitch>
                </StackPanel>

                <!--  Auto mode: short explanation  -->
                <TextBlock
                    Margin="5"
                    FontSize="20"
                    Foreground="#666666"
                    Text="GPS受信機の値を使用します"
                    Visibility="{Binding IsManualGps, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                <!--  Manual entry: only visible in manual mode  -->
                <Grid Visibility="{Binding IsManualGps, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="100"
                        VerticalAlignment="Center"
                        FontSize="25"
                        Style="{StaticResource LabelTextStyle}"
                        Text="緯度" />
                    <ui:TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        VerticalContentAlignment="Center"
                        FontSize="20"
                        PlaceholderText="例: 35.68520"
                        Text="{Binding LatitudeText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Width="100"
                        VerticalAlignment="Center"
                        FontSize="25"
                        Style="{StaticResource LabelTextStyle}"
                        Text="経度" />
                    <ui:TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        VerticalContentAlignment="Center"
                        FontSize="20"
                        PlaceholderText="例: 139.75268"
                        Text="{Binding LongitudeText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="5"
                        FontSize="20"
                        Foreground="#666666"
                        Text="10進数で入力（例: 35.68520）" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!--  Error message (empty when everything is fine)  -->
        <TextBlock
            Grid.Row="1"
            MinHeight="44"
            Margin="0,16,0,0"
            VerticalAlignment="Center"
            FontSize="26"
            Foreground="Red"
            Text="{Binding ErrorMessage}"
            TextWrapping="Wrap" />

        <!--  Save / cancel  -->
        <Grid Grid.Row="2" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Command="{Binding SaveCommand}"
                Content="保存"
                FontSize="30"
                Style="{StaticResource PrimaryButtonStyle}" />
            <Button
                Grid.Column="2"
                Content="キャンセル"
                FontSize="30"
                IsCancel="True"
                Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
