<UserControl
    x:Class="JSAT_UNDAI.Views.MainPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:JSAT_UNDAI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:JSAT_UNDAI.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MainPageViewModel}"
    mc:Ignorable="d">
    <Viewbox
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Stretch="Fill"
        StretchDirection="Both"
        UseLayoutRounding="True">
        <Grid
            Width="1920"
            Height="1200"
            Background="#F0F4FF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="10"
                FontSize="24"
                FontWeight="Bold"
                Text="Main Page" />
            <StackPanel Grid.Row="1" Margin="10">
                <ui:Button
                    Width="100"
                    Height="30"
                    Margin="0,0,0,10"
                    Command="{Binding ClickMeCommand}"
                    Content="Click Me"
                    Style="{StaticResource NavGhostButtonStyle}" />
                <ui:TextBox Width="200" PlaceholderText="Enter text here" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="10">
                <ui:Button
                    Width="150"
                    Height="30"
                    Margin="0,0,0,10"
                    Command="{Binding NavigateToSettingPageCommand}"
                    Content="Setting Page"
                    Style="{StaticResource NavPrimaryButtonStyle}" />
                <Grid Width="300">
                    <Border
                        BorderBrush="Black"
                        BorderThickness="2"
                        CornerRadius="5">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Direction="315"
                                Opacity="0.45"
                                ShadowDepth="4" />
                        </Border.Effect>
                        <ui:Button
                            x:Name="ConnectButton"
                            Height="50"
                            Background="{Binding ConnectionButtonColor}"
                            Command="{Binding ConnectButtonClickedCommand}"
                            Content="{Binding ConnectionButtonLabel}"
                            FontSize="20"
                            Style="{StaticResource NavPrimaryButtonStyle}"
                            Tag="{Binding ConnectionButtonHoverColor}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding ConnectButtonPressedCommand}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                    <i:InvokeCommandAction Command="{Binding ConnectButtonReleasedCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ui:Button>
                    </Border>

                    <Border
                        Height="3"
                        Margin="0,0,0,2"
                        VerticalAlignment="Bottom"
                        Background="#33000000"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsDisconnectHolding, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            HorizontalAlignment="Left"
                            Background="White"
                            Opacity="0.9">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                    <Binding ElementName="ConnectButton" Path="ActualWidth" />
                                    <Binding Path="DisconnectHoldProgress" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </Grid>
                <Grid Width="300">
                    <Border
                        Margin="0,5"
                        BorderBrush="Black"
                        BorderThickness="2"
                        CornerRadius="5">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Direction="315"
                                Opacity="0.45"
                                ShadowDepth="4" />
                        </Border.Effect>
                        <Button
                            x:Name="LogoutButton"
                            Height="50"
                            Background="#490206"
                            Content="ログアウト"
                            FontSize="20"
                            Style="{StaticResource NavPrimaryButtonStyle}"
                            Tag="{Binding LogoutButtonHoverColor}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding LogoutButtonPressedCommand}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                    <i:InvokeCommandAction Command="{Binding LogoutButtonReleasedCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                    </Border>

                    <Border
                        Height="3"
                        Margin="0,0,0,2"
                        VerticalAlignment="Bottom"
                        Background="#33000000"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsLogoutHolding, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            HorizontalAlignment="Left"
                            Background="White"
                            Opacity="0.9">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                    <Binding ElementName="LogoutButton" Path="ActualWidth" />
                                    <Binding Path="LogoutHoldProgress" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
