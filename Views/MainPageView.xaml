<UserControl
    x:Class="JSAT_UNDAI.Views.MainPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="clr-namespace:JSAT_UNDAI.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:JSAT_UNDAI.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MainPageViewModel}"
    mc:Ignorable="d">

    <!--  Fixed 1920x1080 design canvas, scaled uniformly (no distortion). Window background (LightYellow) fills the bars.  -->
    <Viewbox Style="{StaticResource DesignCanvasViewboxStyle}">

        <Grid Style="{StaticResource DesignCanvasGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="120" />
            </Grid.RowDefinitions>

            <!--  =====================================================  -->
            <!--  TOP BAR: connect / GPS status / clock  -->
            <!--  =====================================================  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <!--  Connect button. While connected: hold 2 s to disconnect (progress bar shows the hold).  -->
                <Grid
                    Grid.Column="0"
                    Height="90"
                    VerticalAlignment="Top">
                    <Button
                        x:Name="ConnectButton"
                        Background="{Binding ConnectionButtonColor}"
                        Command="{Binding ConnectButtonClickedCommand}"
                        Content="{Binding ConnectionButtonLabel}"
                        Foreground="White"
                        Style="{StaticResource PanelButtonStyle}"
                        Stylus.IsFlicksEnabled="False"
                        Stylus.IsPressAndHoldEnabled="False">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding ConnectButtonPressedCommand}" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                <i:InvokeCommandAction Command="{Binding ConnectButtonReleasedCommand}" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="LostMouseCapture">
                                <i:InvokeCommandAction Command="{Binding ConnectButtonReleasedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Button>

                    <Border
                        x:Name="ConnectHoldTrack"
                        Height="6"
                        Margin="24,0,24,10"
                        VerticalAlignment="Bottom"
                        Background="#33000000"
                        CornerRadius="3"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsDisconnectHolding, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            HorizontalAlignment="Left"
                            Background="White"
                            CornerRadius="3"
                            Opacity="0.9">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                    <Binding ElementName="ConnectHoldTrack" Path="ActualWidth" />
                                    <Binding Path="DisconnectHoldProgress" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </Grid>

                <!--  GPS status  -->
                <Border
                    Grid.Column="2"
                    Height="90"
                    VerticalAlignment="Top"
                    Background="{Binding GpsStatusColor}"
                    CornerRadius="5"
                    IsEnabled="{Binding IsControlEnabled}"
                    Style="{StaticResource StatusBadgeBorderStyle}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="40"
                        Foreground="White"
                        Text="{Binding GpsStatusText}" />
                </Border>

                <!--  Modem status  -->
                <Border
                    Grid.Column="4"
                    Height="90"
                    VerticalAlignment="Top"
                    Background="{Binding ModemStatusColor}"
                    CornerRadius="5"
                    IsEnabled="{Binding IsControlEnabled}"
                    Style="{StaticResource StatusBadgeBorderStyle}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="40"
                        Foreground="White"
                        Text="{Binding ModemStatusText}" />
                </Border>

                <!--  Clock  -->
                <StackPanel
                    Grid.Column="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="56"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{Binding TimeText}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="30"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{Binding DateText}" />
                </StackPanel>
            </Grid>

            <!--  =====================================================  -->
            <!--  MAIN AREA  -->
            <!--  =====================================================  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1000" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ================= LEFT: manual control + installation position =================  -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Manual control: disabled as a whole when IsControlEnabled is false (not connected).  -->
                    <Grid Grid.Row="0" IsEnabled="{Binding IsControlEnabled}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Speed mode (selected button turns blue via Tag)  -->
                        <Grid Grid.Row="0" Height="70">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Command="{Binding SelectSpeedModeCommand}"
                                CommandParameter="High"
                                Content="高速"
                                Style="{StaticResource PanelButtonStyle}"
                                Tag="{Binding IsHighSpeed}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding SelectSpeedModeCommand}"
                                CommandParameter="Low"
                                Content="低速"
                                Style="{StaticResource PanelButtonStyle}"
                                Tag="{Binding IsLowSpeed}" />
                            <Button
                                Grid.Column="4"
                                Command="{Binding SelectSpeedModeCommand}"
                                CommandParameter="Inching"
                                Content="寸動"
                                Style="{StaticResource PanelButtonStyle}"
                                Tag="{Binding IsInching}" />
                        </Grid>

                        <!--  Elevation card + Azimuth card  -->
                        <Grid Grid.Row="1" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Elevation: [UP]  current angle  [DOWN]  -->
                            <Border
                                Grid.Column="0"
                                Padding="20,5,20,20"
                                Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="仰角" />

                                        <!--  Current elevation: same black value box as the rest of the screen  -->
                                        <Border
                                            Grid.Column="1"
                                            Height="90"
                                            Margin="0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource ValueBoxBorderStyle}">
                                            <Grid Margin="0,2,0,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    Grid.Row="0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="20"
                                                    Foreground="#B0B0B0"
                                                    Text="現在値" />
                                                <Viewbox
                                                    Grid.Row="1"
                                                    Stretch="Uniform"
                                                    StretchDirection="DownOnly">
                                                    <TextBlock Style="{StaticResource ValueBoxTextStyle}">
                                                        <Run Text="{Binding CurrentElevation, Mode=OneWay}" /><Run Text="°" />
                                                    </TextBlock>
                                                </Viewbox>
                                            </Grid>
                                        </Border>

                                    </Grid>
                                    <Grid
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Column="0"
                                            Width="170"
                                            Height="170"
                                            Padding="0"
                                            Style="{StaticResource PanelButtonStyle}"
                                            Stylus.IsFlicksEnabled="False"
                                            Stylus.IsPressAndHoldEnabled="False">
                                            <Image Width="120" Source="/Resources/UP ARROW.png" />
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                    <i:InvokeCommandAction Command="{Binding JogPressedCommand}" CommandParameter="Up" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                                    <i:InvokeCommandAction Command="{Binding JogReleasedCommand}" CommandParameter="Up" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="MouseLeave">
                                                    <i:InvokeCommandAction Command="{Binding JogReleasedCommand}" CommandParameter="Up" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="LostMouseCapture">
                                                    <i:InvokeCommandAction Command="{Binding JogReleasedCommand}" CommandParameter="Up" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </Button>

                                        <Button
                                            Grid.Column="2"
                                            Width="170"
                                            Height="170"
                                            Padding="0"
                                            Style="{StaticResource PanelButtonStyle}"
                                            Stylus.IsFlicksEnabled="False"
                                            Stylus.IsPressAndHoldEnabled="False">
                                            <Image Width="120" Source="/Resources/DOWN ARROW.png" />
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                    <i:InvokeCommandAction Command="{Binding JogPressedCommand}" CommandParameter="Down" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                                    <i:InvokeCommandAction Command="{Binding JogReleasedCommand}" CommandParameter="Down" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="MouseLeave">
                                                    <i:InvokeCommandAction Command="{Binding JogReleasedCommand}" CommandParameter="Down" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="LostMouseCapture">
                                                    <i:InvokeCommandAction Command="{Binding JogReleasedCommand}" CommandParameter="Down" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </Button>
                                    </Grid>

                                    <!--  Go-to angle: [位置決め] [value box -> keypad]  -->
                                    <Grid
                                        Grid.Row="2"
                                        Height="80"
                                        Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="15" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Command="{Binding SetElevationAngleCommand}"
                                            Content="位置決め"
                                            FontSize="36"
                                            Style="{StaticResource PanelButtonStyle}" />
                                        <ui:TextBox
                                            Grid.Column="2"
                                            VerticalContentAlignment="Center"
                                            beh:NumericInput.IsDecimalOnly="True"
                                            FontSize="40"
                                            PlaceholderText="90.0"
                                            Text="{Binding ElevationAngleInput, UpdateSourceTrigger=PropertyChanged}"
                                            TextAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!--  Azimuth: [CCW]  current angle  [CW]  -->
                            <Border
                                Grid.Column="2"
                                Padding="20,5,20,20"
                                Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="水平角" />

                                        <!--  Current azimuth: same black value box as the rest of the screen  -->
                                        <Border
                                            Grid.Column="1"
                                            Height="90"
                                            Margin="0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource ValueBoxBorderStyle}">
                                            <Grid Margin="0,2,0,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    Grid.Row="0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="20"
                                                    Foreground="#B0B0B0"
                                                    Text="現在値" />
                                                <Viewbox
                                                    Grid.Row="1"
                                                    Stretch="Uniform"
                                                    StretchDirection="DownOnly">
                                                    <TextBlock Style="{StaticResource ValueBoxTextStyle}">
                                                        <Run Text="{Binding CurrentAzimuth, Mode=OneWay}" /><Run Text="°" />
                                                    </TextBlock>
                                                </Viewbox>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Grid
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Column="0"
                                            Width="170"
                                            Height="170"
                                            Padding="0"
                                            Style="{StaticResource PanelButtonStyle}"
                                            Stylus.IsFlicksEnabled="False"
                                            Stylus.IsPressAndHoldEnabled="False">
                                            <Image Width="120" Source="/Resources/CCW ROTATE.png" />
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                    <i:InvokeCommandAction Command="{Binding JogPressedCommand}" CommandParameter="CCW" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                                    <i:InvokeCommandAction Command="{Binding JogReleasedCommand}" CommandParameter="CCW" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="MouseLeave">
                                                    <i:InvokeCommandAction Command="{Binding JogReleasedCommand}" CommandParameter="CCW" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="LostMouseCapture">
                                                    <i:InvokeCommandAction Command="{Binding JogReleasedCommand}" CommandParameter="CCW" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </Button>

                                        <Button
                                            Grid.Column="2"
                                            Width="170"
                                            Height="170"
                                            Padding="0"
                                            Style="{StaticResource PanelButtonStyle}"
                                            Stylus.IsFlicksEnabled="False"
                                            Stylus.IsPressAndHoldEnabled="False">
                                            <Image Width="120" Source="/Resources/CW ROTATE.png" />
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                    <i:InvokeCommandAction Command="{Binding JogPressedCommand}" CommandParameter="CW" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                                    <i:InvokeCommandAction Command="{Binding JogReleasedCommand}" CommandParameter="CW" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="MouseLeave">
                                                    <i:InvokeCommandAction Command="{Binding JogReleasedCommand}" CommandParameter="CW" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="LostMouseCapture">
                                                    <i:InvokeCommandAction Command="{Binding JogReleasedCommand}" CommandParameter="CW" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </Button>
                                    </Grid>

                                    <!--  Go-to angle: [位置決め] [value box -> keypad]  -->
                                    <Grid
                                        Grid.Row="2"
                                        Height="80"
                                        Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="15" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Command="{Binding SetAzimuthAngleCommand}"
                                            Content="位置決め"
                                            FontSize="36"
                                            Style="{StaticResource PanelButtonStyle}" />
                                        <ui:TextBox
                                            Grid.Column="2"
                                            VerticalContentAlignment="Center"
                                            beh:NumericInput.IsDecimalOnly="True"
                                            FontSize="40"
                                            PlaceholderText="90.0"
                                            Text="{Binding AzimuthAngleInput, UpdateSourceTrigger=PropertyChanged}"
                                            TextAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!--  Save / load angle  -->
                        <Grid Grid.Row="2" Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Command="{Binding SaveAngleCommand}"
                                Content="位置保存"
                                Style="{StaticResource PanelButtonStyle}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding LoadAngleCommand}"
                                Content="位置復元"
                                Style="{StaticResource PanelButtonStyle}" />
                        </Grid>
                    </Grid>

                    <!--  Installation position: unit button + latitude / longitude  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,15,0,0"
                        Padding="15"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding IsControlEnabled}"
                        Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <!--  Unit toggle  -->
                            <Button
                                Grid.Column="0"
                                Width="150"
                                Height="150"
                                Command="{Binding ToggleUnitCommand}"
                                Style="{StaticResource PanelButtonStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="40"
                                        Text="ユニット"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        FontSize="34"
                                        FontWeight="SemiBold"
                                        Text="{Binding UnitLabel}"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!--  雲台: GPS position  -->
                            <GroupBox Grid.Column="2" Style="{StaticResource PanelGroupBoxStyle}">
                                <GroupBox.Header>
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="雲台" />
                                </GroupBox.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="80" />
                                        <RowDefinition Height="80" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource LabelTextStyle}"
                                        Text="緯度" />
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueBoxBorderStyle}">
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                            <TextBlock
                                                FontSize="36"
                                                Style="{StaticResource ValueBoxTextStyle}"
                                                Text="{Binding Latitude}" />
                                        </Viewbox>
                                    </Border>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource LabelTextStyle}"
                                        Text="経度" />
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueBoxBorderStyle}">
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                            <TextBlock
                                                FontSize="36"
                                                Style="{StaticResource ValueBoxTextStyle}"
                                                Text="{Binding Longitude}" />
                                        </Viewbox>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <!--  衛星: geostationary satellite  -->
                            <GroupBox Grid.Column="4" Style="{StaticResource PanelGroupBoxStyle}">
                                <GroupBox.Header>
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="衛星" />
                                </GroupBox.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="80" />
                                        <RowDefinition Height="80" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource LabelTextStyle}"
                                        Text="衛星名" />
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueBoxBorderStyle}">
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                            <TextBlock
                                                FontSize="36"
                                                Style="{StaticResource ValueBoxTextStyle}"
                                                Text="{Binding SatelliteName}" />
                                        </Viewbox>
                                    </Border>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource LabelTextStyle}"
                                        Text="経度" />
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueBoxBorderStyle}">
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                            <TextBlock
                                                FontSize="36"
                                                Style="{StaticResource ValueBoxTextStyle}"
                                                Text="{Binding SatelliteLongitude}" />
                                        </Viewbox>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <!--  UNDAI Satellite Edit button  -->
                            <Button
                                Grid.Column="6"
                                Width="100"
                                Height="150"
                                Command="{Binding EditInstallationCommand}"
                                Content="編集"
                                FontSize="32"
                                Style="{StaticResource PanelButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>

                <!--  ================= RIGHT: SNR / peak position / target / actions / stop / system setting =================  -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  1) SNR: current and peak  -->
                    <Border
                        Grid.Row="0"
                        Padding="20,10"
                        IsEnabled="{Binding IsControlEnabled}"
                        Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelTextStyle}"
                                Text="SNR"
                                TextAlignment="Center" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,15,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelTextStyle}"
                                Text="現在値" />
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource ValueBoxBorderStyle}">
                                <TextBlock
                                    FontSize="50"
                                    Style="{StaticResource ValueBoxTextStyle}"
                                    Text="{Binding CurrentRssi}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!--  2) Peak search result: elevation and azimuth where the peak was found  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,5,0,0"
                        Padding="20,10"
                        IsEnabled="{Binding IsControlEnabled}"
                        Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Style="{StaticResource LabelTextStyle}"
                                Text="SNR" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                Style="{StaticResource LabelTextStyle}"
                                Text="仰角" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                Style="{StaticResource LabelTextStyle}"
                                Text="水平角" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,15,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelTextStyle}"
                                Text="ピーク値" />
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource ValueBoxBorderStyle}">
                                <TextBlock
                                    FontSize="50"
                                    Style="{StaticResource ValueBoxTextStyle}"
                                    Text="{Binding PeakElevation}" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource ValueBoxBorderStyle}">
                                <TextBlock
                                    FontSize="50"
                                    Style="{StaticResource ValueBoxTextStyle}"
                                    Text="{Binding PeakAzimuth}" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="3"
                                Style="{StaticResource ValueBoxBorderStyle}">
                                <TextBlock
                                    FontSize="50"
                                    Style="{StaticResource ValueBoxTextStyle}"
                                    Text="{Binding PeakRssi}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!--  3) Target values  -->
                    <Border
                        Grid.Row="2"
                        Margin="0,5,0,0"
                        Padding="20,10"
                        IsEnabled="{Binding IsControlEnabled}"
                        Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Style="{StaticResource LabelTextStyle}"
                                Text="偏波角" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                Style="{StaticResource LabelTextStyle}"
                                Text="仰角" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="3"
                                HorizontalAlignment="Center"
                                Style="{StaticResource LabelTextStyle}"
                                Text="水平角" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,15,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelTextStyle}"
                                Text="目的値" />
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource ValueBoxBorderStyle}">
                                <TextBlock
                                    FontSize="50"
                                    Style="{StaticResource ValueBoxTextStyle}"
                                    Text="{Binding TargetPolarize}" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource ValueBoxBorderStyle}">
                                <TextBlock
                                    FontSize="50"
                                    Style="{StaticResource ValueBoxTextStyle}"
                                    Text="{Binding TargetElevation}" />
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.Column="3"
                                Style="{StaticResource ValueBoxBorderStyle}">
                                <TextBlock
                                    FontSize="50"
                                    Style="{StaticResource ValueBoxTextStyle}"
                                    Text="{Binding TargetAzimuth}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!--  Home / peak search (disabled when not connected)  -->
                    <Grid
                        Grid.Row="3"
                        Height="80"
                        Margin="0,15,0,0"
                        IsEnabled="{Binding IsControlEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Command="{Binding HomeCommand}"
                            Content="原点"
                            Style="{StaticResource PanelButtonStyle}"
                            Tag="{Binding IsHoming}" />
                        <Button
                            Grid.Column="2"
                            Command="{Binding PeakSearchCommand}"
                            Content="ピークサーチ"
                            Style="{StaticResource PanelButtonStyle}"
                            Tag="{Binding IsPeakSearching}" />
                    </Grid>

                    <!--  STOP: fires on press (not on release)  -->
                    <Button
                        Grid.Row="4"
                        Height="180"
                        Margin="0,15,0,0"
                        ClickMode="Press"
                        Command="{Binding StopCommand}"
                        Content="停止"
                        IsEnabled="{Binding IsControlEnabled}"
                        Style="{StaticResource StopButtonStyle}" />

                    <!--  System setting  -->
                    <Button
                        Grid.Row="5"
                        Height="80"
                        Margin="0,15,0,0"
                        Command="{Binding NavigateToSettingPageCommand}"
                        Content="システム設定"
                        FontSize="34"
                        Style="{StaticResource PanelButtonYellowStyle}" />
                </Grid>
            </Grid>

            <!--  =====================================================  -->
            <!--  BOTTOM BAR: alarm reset / status / logout  -->
            <!--  =====================================================  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Height="90"
                    VerticalAlignment="Bottom"
                    Command="{Binding AlarmResetCommand}"
                    Content="アラームリセット"
                    FontSize="34"
                    Style="{StaticResource PanelButtonStyle}" />

                <Border
                    Grid.Column="2"
                    Height="90"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource StatusBarBorderStyle}">
                    <TextBlock
                        Margin="20,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="40"
                        Foreground="White"
                        Text="{Binding StatusMessage}"
                        TextTrimming="CharacterEllipsis" />
                </Border>

                <!--  Logout: hold 2 s (progress bar shows the hold)  -->
                <Grid
                    Grid.Column="4"
                    Height="90"
                    VerticalAlignment="Bottom">
                    <Button
                        x:Name="LogoutButton"
                        Background="{StaticResource DangerBrush}"
                        Content="ログアウト"
                        Foreground="White"
                        Style="{StaticResource PanelButtonStyle}"
                        Stylus.IsFlicksEnabled="False"
                        Stylus.IsPressAndHoldEnabled="False">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding LogoutButtonPressedCommand}" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                <i:InvokeCommandAction Command="{Binding LogoutButtonReleasedCommand}" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="LostMouseCapture">
                                <i:InvokeCommandAction Command="{Binding LogoutButtonReleasedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Button>

                    <Border
                        x:Name="LogoutHoldTrack"
                        Height="6"
                        Margin="20,0,20,10"
                        VerticalAlignment="Bottom"
                        Background="#33000000"
                        CornerRadius="3"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsLogoutHolding, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            HorizontalAlignment="Left"
                            Background="White"
                            CornerRadius="3"
                            Opacity="0.9">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                    <Binding ElementName="LogoutHoldTrack" Path="ActualWidth" />
                                    <Binding Path="LogoutHoldProgress" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>